<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctors</title>
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    @await Html.PartialAsync("_Header")

      <div class="doctors-container">
    <h1>Our Dentists</h1>
    <p>Meet our experienced dental team.</p>
    <div class="doctor-card">
     <div class="doctor-info"><h2>Dr.Hossein Aalami</h2><h3>General Dentist</h3><p>Experienced in dental checkup and teeth cleaning</p></div>
        <div class="doctor-image"><img src="Images/hero.jpg" alt="Dr.Hossein Aalami"></div>
         </div>

        <div class="doctor-card">
     <div class="doctor-info"><h2>Dr.Sarah Smith</h2><h3>General Dentist</h3><p>Experienced in dental checkup and teeth cleaning</p></div>
        <div class="doctor-image"><img src="Images/sarah1.jpg" alt="Dr.Sarah Smith"></div>
         </div>

<div class="doctor-card">
     <div class="doctor-info"><h2>Dr.James Anderson</h2><h3>Dental Surgeon - Canal Root Therapist</h3><p>Provides expert surgical care for healthy teeth and gums</p></div>
        <div class="doctor-image"><img src="Images/James1.png" alt="Dr.James Anderson"></div>
         </div>

         <div class="doctor-card">
     <div class="doctor-info"><h2>Dr.Emily Johnson</h2><h3>Cosmetic Dentist</h3><p>Creates beautiful smiles with personalized cosmetic care</p></div>
        <div class="doctor-image"><img src="Images/Emily1.png" alt="Dr.Emily Johnson"></div>
         </div>

         <div class="doctor-card">
     <div class="doctor-info"><h2>Dr.Michael Brown</h2><h3>Orthodontist</h3><p>Helps straighten teeth for a healthier, confident smile</p></div>
        <div class="doctor-image"><img src="Images/Michael1.png" alt="Dr.Michael Brown"></div>
         </div>

        
        </div>


    </div>
     @await Html.PartialAsync("_Footer")
   <script src="~/js/script.js"></script>
</body>
</html>